{
    "git": {
        "deploymentEnabled": {
            "Production": true,
            "*": false
        }
    },
    "rewrites": [
        {
            "source": "/__/auth/:path*",
            "destination": "https://clawhost-prod.firebaseapp.com/__/auth/:path*"
        },
        {
            "source": "/api/cron/:path*",
            "destination": "https://api.clawhost.cloud/cron/:path*"
        },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "crons": [
        {
            "path": "/api/cron/send-feature-emails",
            "schedule": "*/10 * * * *"
        },
        {
            "path": "/api/cron/generate-blog-post",
            "schedule": "0 * * * *"
        }
    ]
}
